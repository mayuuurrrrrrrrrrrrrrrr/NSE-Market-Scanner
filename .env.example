# ==============================================================================
# NSE Market Intelligence Platform - Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="NSE Market Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Defaults to SQLite for local development; switch to PostgreSQL for Production)
DATABASE_URL="sqlite:///./nse_platform.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nse_platform"
DB_ECHO=False

# Zerodha Kite Connect API
ZERODHA_API_KEY="your_kite_api_key"
ZERODHA_API_SECRET="your_kite_api_secret"
ZERODHA_ACCESS_TOKEN=""

# Telegram Bot API Alerts
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Google Gemini AI Integration
GG_API_KEY="your_gemini_api_key"

# Market Scanning Configuration
SCAN_UNIVERSE="NIFTY50"
SCAN_INTERVAL_MINUTES=15
